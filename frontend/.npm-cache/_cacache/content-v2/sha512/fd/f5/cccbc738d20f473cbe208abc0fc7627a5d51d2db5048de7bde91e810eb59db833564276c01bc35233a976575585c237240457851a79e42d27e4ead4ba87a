ages-npm-production","tmp":"tmp/jest-ts-webcompat-resolver_1.0.1_1745435271030_0.5087853933813162"},"_hasShrinkwrap":false}},"time":{"created":"2019-04-09T19:41:40.694Z","modified":"2025-04-23T19:07:51.409Z","1.0.0":"2019-04-09T19:41:40.909Z","1.0.1":"2025-04-23T19:07:51.239Z"},"bugs":{"url":"https://github.com/AyogoHealth/jest-ts-webcompat-resolver/issues"},"author":{"name":"Darryl Pogue","email":"darryl@dpogue.ca"},"license":"MIT","homepage":"https://github.com/AyogoHealth/jest-ts-webcompat-resolver","repository":{"type":"git","url":"git+https://github.com/AyogoHealth/jest-ts-webcompat-resolver.git"},"description":"A resolver for Jest that handles TypeScript imports using a `.js` extension.","maintainers":[{"name":"dpogue","email":"darryl@dpogue.ca"},{"name":"ayogohealth","email":"accounts@ayogo.com"}],"readme":"Jest TypeScript Web-Compatible Resolver\n=======================================\n\nTypeScript allows importing other TypeScript files with a `.js` extension, for\ncompatibility with the ES6 modules loader specification. Unfortunately, Jest\ngets confused by this and complains that it's not able to find the JavaScript\nfile.\n\nThis is a resolver that catches that error, and then tries to resolve it again\nbut with a `.ts` extension.\n\n\nInstallation & Set-Up\n---------------------\n\nInstall this module into your project using npm:\n\n```\nnpm install -D jest-ts-webcompat-resolver\n```\n\nThen add it to your Jest config file as the resolver:\n\n```\n\"resolver\": \"jest-ts-webcompat-resolver\"\n```\n\n\nLicence\n-------\n\nThis project is licensed under the [MIT Licence][mit].\n\n[mit]:\n  https://github.com/AyogoHealth/jest-ts-webcompat-resolver/blob/master/LICENSE\n","readmeFilename":"README.md"}