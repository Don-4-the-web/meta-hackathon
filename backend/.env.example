# Copy to .env and fill in. Never commit the real key.
# Create the key in the Meta Model API dashboard (dev.meta.ai -> Model API -> API keys).
META_API_KEY=
# Meta Model API (OpenAI-compatible). Keys start with LLM_
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-wonder-1.0
TRAINING_PROVIDER=modal
MODAL_APP_NAME=meta-lora-studio
MODAL_STARTER_FUNCTION=start_training
MODAL_GENERATE_FUNCTION=generate_character
MODAL_VOLUME_NAME=lora-studio
MODAL_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
MODAL_SUBMIT_TIMEOUT_SECONDS=180
MODAL_MAX_TRAIN_STEPS=400
DATABASE_URL=sqlite:///./chat.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
